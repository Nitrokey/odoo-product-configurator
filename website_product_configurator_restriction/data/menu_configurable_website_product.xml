<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <menuitem
        id="menu_website_product_configurable"
        name="Website Product Configurator"
        sequence="20"
    />
    <menuitem
        id="menu_website_product_configurable_product_main"
        name="Configurable Products"
        parent="menu_website_product_configurable"
        sequence="10"
    />
    <menuitem
        id="menu_website_product_configurable_settings"
        name="Configuration"
        parent="menu_website_product_configurable"
        sequence="20"
    />

    <!-- Product Menu -->
    <record id="website_product_configurable_template_action" model="ir.actions.act_window">
        <field name="name">Configurable Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="product.product_template_kanban_view" />
        <field
            name="context"
        >{'default_restrict_config_ok': True, 'custom_create_variant': True, 'search_default_filter_restrict_config_ok': 1}</field>
    </record>

    <menuitem
        action="website_product_configurable_template_action"
        id="menu_website_product_configurable_template_action"
        parent="menu_website_product_configurable_product_main"
        sequence="20"
    />

    <record id="website_product_configurable_variant_action" model="ir.actions.act_window">
        <field name="name">Configured Variants</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,form,tree</field>
        <field name="search_view_id" ref="product.product_search_form_view" />
        <field name="view_id" eval="False" />
        <field
            name="context"
        >{'default_restrict_config_ok': True, 'custom_create_variant': True, 'search_default_filter_restrict_config_ok': 1}</field>
    </record>

    <menuitem
        id="menu_website_product_configurable_variants_action"
        action="website_product_configurable_variant_action"
        name="Configurable Variants"
        parent="menu_website_product_configurable_product_main"
        sequence="25"
    />

    <!-- Configuration Menu -->
    <record id="product_config_domain_action" model="ir.actions.act_window">
        <field name="name">Configuration Restrictions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">website.product.config.domain</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_website_product_config_domain_action"
        action="product_config_domain_action"
        name="Configuration Restrictions"
        parent="menu_website_product_configurable_settings"
        sequence="40"
    />


</odoo>
